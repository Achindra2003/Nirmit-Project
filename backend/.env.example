LLM_PROVIDER=groq
# Free tier ~100k tokens/day — keep optional generate flags false unless you need them.
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Room generation: false = deterministic copy & palettes (no Groq calls per vision).
LLM_INTERPRET_ON_GENERATE=false
LLM_STYLE_ON_GENERATE=false
LLM_RANKER_ON_GENERATE=false

API_HOST=127.0.0.1
API_PORT=8000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
